# =========================
# CQIM 生产环境变量模板
# 复制为 .env 后按需填写
# =========================

# 运行环境
NODE_ENV=production
PORT=3000

# MongoDB 主业务数据库（用户、会话、好友关系、群组、消息、动态等）
# Docker Compose 默认服务名为 mongo，并在首次健康检查时自动初始化 rs0
DATABASE_URL="mongodb://mongo:27017/cqim?replicaSet=rs0&directConnection=true"
MONGO_PORT=27017

# Redis 实时状态与缓存（在线状态、设备心跳、验证码频控、会话热缓存、Pub/Sub）
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# MySQL 审计与后台运营数据（管理员操作日志、登录日志、非法请求日志等）
MYSQL_URL=mysql://cqim:cqim@mysql:3306/cqim_audit
MYSQL_PORT=3306
MYSQL_AUDIT_ENABLED=true
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=cqim_audit
MYSQL_USER=cqim
MYSQL_PASSWORD=cqim
MYSQL_POOL_SIZE=10
MYSQL_MAX_IDLE=10
MYSQL_IDLE_TIMEOUT_MS=60000

# AI 能力（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# OneBot 反向 WebSocket 鉴权（可选，建议生产开启）
ONEBOT_ACCESS_TOKEN=

# OAuth 登录页（可选，不配置则使用站内登录）
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# 前端埋点统计（可选）
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# 地图能力（可选）
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Apple APNs（服务端 apns.ts，p8 放 cqim-app/certs/AuthKey_URP8X87T38.p8）
APPLE_TEAM_ID=4U332QFN6D
APPLE_BUNDLE_ID=com.imim.chat

# 极光 JPush（iOS 客户端 SDK 初始化用）
JPUSH_APP_KEY=2f496988f16573ad08321835
JPUSH_APNS_KEY_ID=URP8X87T38
# 服务端 REST 推送必填（控制台 → 应用设置 → Master Secret）
JPUSH_MASTER_SECRET=

# 前端 Sentry（仅生产且显式开启；不配置 DSN 或开关不是 true 时 no-op）
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
# Vite 客户端读取 VITE_ 前缀；部署脚本可将 SENTRY_ENABLED 注入为 VITE_SENTRY_ENABLED
SENTRY_ENABLED=false
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_APP_VERSION=
