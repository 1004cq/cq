# ######### 基础配置 #########
# 服务器的对外IP地址
EXTERNAL_IP=your_server_ip

# mysql root用户的密码（⚠️ 请使用16位以上强密码：含大小写字母+数字+特殊字符）
MYSQL_ROOT_PASSWORD=your_mysql_password

# mysql默认数据库名字
MYSQL_DATABASE=im

# ######### Minio文件服务配置 #########
# minio文件服务的用户名
MINIO_ROOT_USER=minio

# minio文件服务的密码（⚠️ 请使用16位以上强密码）
MINIO_ROOT_PASSWORD=your_minio_password

# ######### WuKongIM相关的配置 #########
# 模式 debug or release
WK_MODE=release

# 开启最近会话服务端维护
WK_CONVERSATION_ON=true

# 业务服务的grpc地址
WK_WEBHOOK_GRPCADDR=tangsengdaodaoserver:6979

# 业务服务的数据源地址
WK_DATASOURCE_ADDR=http://tangsengdaodaoserver:8090/v1/datasource

# 开启频道信息同步
WK_DATASOURCE_CHANNELINFOON=true

# 开启token认证
WK_TOKENAUTHON=true

# 是否关闭个人白名单功能
WK_WHITELISTOFFOFPERSON=false

# JWT的密钥（⚠️ 请修改为32位以上随机字符串，建议定期轮换）
WK_JWT_SECRET=your_jwt_secret_here

# ######### TangSengDaoDao的配置 #########
# 模式 debug or release
TS_MODE=release

# wukongim的内网访问地址
TS_WUKONGIM_APIURL=http://wukongim:5001

# redis连接地址
TS_DB_REDISADDR=redis:6379

# 验证码（固定验证码，方便测试；生产环境建议接入短信服务商）
# 生产环境请改为真实短信服务配置
TS_SMSCODE=123456

# 使用文件服务的类型（minio / oss / cos）
TS_FILESERVICE=minio

# 默认头像获取地址
TS_AVATAR_DEFAULTBASEURL=https://api.dicebear.com/8.x/avataaars/png?seed={avatar}&size=180

# 唐僧叨叨后台管理系统的管理员密码，用户名为 superAdmin（⚠️ 请使用16位以上强密码）
TS_ADMINPWD=your_admin_password

# 唐僧叨叨的文件服务地址
TS_MINIO_UPLOADURL=http://minio:9000

# ######### 注册中间件配置 #########
# 短信服务商：mock（测试模式，验证码打印到日志）或 aliyun_dypns（阿里云号码认证）
SMS_PROVIDER=mock

# 阿里云号码认证服务配置（SMS_PROVIDER=aliyun_dypns 时必填）
ALIYUN_ACCESS_KEY=
ALIYUN_ACCESS_SECRET=
ALIYUN_DYPNS_SIGN_NAME=速通互联验证码
ALIYUN_DYPNS_TEMPLATE_CODE=100001

# 验证码有效期（秒），默认300秒=5分钟
CODE_EXPIRE=300

# 验证码最大错误次数
CODE_MAX_RETRY=3

# 每IP每小时注册上限
RATE_LIMIT_REGISTER_PER_HOUR=5

# 每手机号每小时短信上限
RATE_LIMIT_SMS_PER_HOUR=3

# ######### TRTC 实时音视频配置 #########
# 在 https://console.cloud.tencent.com/trtc 创建应用获取
# TRTC 应用 ID
TRTC_SDK_APP_ID=
# TRTC 应用密钥（用于生成 UserSig）
TRTC_SECRET_KEY=
# UserSig 有效期（秒），默认 7 天
TRTC_USER_SIG_EXPIRE=604800

# ######### CQIM 自研 IM 应用配置 #########
# MongoDB 主业务数据库（用户、会话、消息、动态等）
CQIM_MONGO_PORT=27017
CQIM_DATABASE_URL=mongodb://mongo:27017/cqim?replicaSet=rs0&directConnection=true
# MongoDB root 密码（⚠️ 请使用16位以上强密码）
CQIM_MONGO_ROOT_PASSWORD=your_mongo_password

# MySQL 审计库（cqim 使用独立的数据库，但共用 MySQL 实例）
CQIM_MYSQL_DATABASE=cqim_audit
CQIM_MYSQL_USER=cqim
CQIM_MYSQL_PASSWORD=your_cqim_mysql_password
CQIM_MYSQL_URL=mysql://cqim:${CQIM_MYSQL_PASSWORD}@mysql:3306/cqim_audit
CQIM_MYSQL_AUDIT_ENABLED=true
CQIM_MYSQL_POOL_SIZE=10

# AI 能力（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# OneBot 反向 WebSocket 鉴权（可选）
ONEBOT_ACCESS_TOKEN=

# 地图能力（可选）
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Go Gateway 群聊 WebSocket 端口（内网）
CQIM_GATEWAY_PORT=8081
