# imimchat Nginx 反向代理配置（完整版）
# 域名: wed.imim.chat
# 更新日期: 2026-06-26
# 架构: WuKongIM (IM引擎) + CQIM (自研全栈) 双系统共存

# COS 代理缓存（cqim 视频/音频分片，加速跨境拉取）
proxy_cache_path /var/cache/nginx/cqim_cos
                 levels=1:2
                 keys_zone=cqim_cos:32m
                 max_size=10g
                 inactive=14d
                 use_temp_path=off;

# 注册接口限流区（每IP每秒2个请求）
limit_req_zone $binary_remote_addr zone=register_limit:10m rate=2r/s;

# API 限流区（每IP每分钟30个请求）
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/m;

# 登录限流区（每IP每分钟5个请求）
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;

# HTTP → HTTPS 重定向
server {
    listen 80;
    server_name wed.imim.chat;
    return 301 https://wed.imim.chat$request_uri;
}

# HTTPS 主配置
server {
    listen 443 ssl;
    http2 on;
    server_name wed.imim.chat;

    # SSL 证书
    ssl_certificate /etc/nginx/ssl/wed.imim.chat.crt;
    ssl_certificate_key /etc/nginx/ssl/wed.imim.chat.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # 上传文件大小限制
    client_max_body_size 200M;

    # ===== 安全响应头 =====
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self' https: wss:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:;" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # ===== Gzip 压缩 =====
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_comp_level 6;
    gzip_proxied any;

    # ===== 静态资源缓存 =====
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$ {
        proxy_pass http://127.0.0.1:82;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # 管理后台静态资源（/admin/static/ -> 端口 83 /static/）
    location /admin/static/ {
        proxy_pass http://127.0.0.1:83/static/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # 管理后台 tsdd-config.js
    location /admin/tsdd-config.js {
        proxy_pass http://127.0.0.1:83/tsdd-config.js;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # 管理后台 logo
    location /admin/logo.png {
        proxy_pass http://127.0.0.1:83/logo.png;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400";
    }

    # 管理后台 API（/admin/api/ -> 端口 83 /api/）
    location /admin/api/ {
        proxy_pass http://127.0.0.1:83/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 管理后台主入口（/admin -> 端口 83，使用 sub_filter 替换资源路径）
    location = /admin {
        return 301 /admin/#/;
    }

    location /admin {
        proxy_pass http://127.0.0.1:83/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter '<head>' '<head><base href="/admin/">';
        sub_filter 'src="/static/' 'src="/admin/static/';
        sub_filter 'href="/static/' 'href="/admin/static/';
        sub_filter 'href="/logo.png"' 'href="/admin/logo.png"';
        sub_filter 'src="/logo.png"' 'src="/admin/logo.png"';
        proxy_set_header Accept-Encoding "";
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # WuKongIM WebSocket 代理（wss://wed.imim.chat/ws -> 5200）
    location /ws {
        proxy_pass http://127.0.0.1:5200;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
    }

    # 业务 API 代理（/api/ -> 8090），带限流
    location /api/ {
        limit_req zone=api_limit burst=10 nodelay;
        proxy_pass http://127.0.0.1:8090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # v1 API 直接代理
    location /v1/ {
        proxy_pass http://127.0.0.1:8090/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # 登录接口特殊限流（防暴力破解）
    location /v1/user/login {
        limit_req zone=login_limit burst=3 nodelay;
        proxy_pass http://127.0.0.1:8090/v1/user/login;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # TRTC UserSig 生成服务（/trtc/ -> 9091），带限流
    location /trtc/ {
        limit_req zone=register_limit burst=5 nodelay;
        proxy_pass http://127.0.0.1:9091/trtc/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # 注册服务代理（/register/ -> 9091），带限流
    location /register/ {
        limit_req zone=register_limit burst=5 nodelay;
        proxy_pass http://127.0.0.1:9091/register/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # ===== CQIM 自研应用路由（端口 3000）=====

    # CQIM 静态资源强缓存（带 hash 的文件）
    location ~* ^/assets/.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|tgs)$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=604800, immutable" always;
    }

    # CQIM 贴纸和媒体静态文件强缓存
    location ~* ^/api/(stickers/files|media/files)/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=604800, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # CQIM COS 代理缓存（视频/音频/图片跨境加速）
    location ^~ /api/cos/proxy/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_cache cqim_cos;
        proxy_cache_key "$scheme$request_method$host$request_uri$http_range";
        proxy_cache_valid 200 206 7d;
        proxy_cache_valid 301 302 1h;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 30s;
        proxy_cache_revalidate on;
        proxy_ignore_headers Set-Cookie Vary;
        proxy_buffering on;
        proxy_buffers 64 128k;
        proxy_buffer_size 256k;

        add_header X-Cache-Status $upstream_cache_status always;
        add_header Cache-Control "public, max-age=604800" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges" always;
    }

    # CQIM API 路由（/cqim/api/ -> 3000 /api/）
    location /cqim/api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # CQIM WebSocket（群聊网关 /ws/group -> 8081）
    location /ws/group {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # CQIM 主应用（/cqim/ -> 3000 /）
    # 如果 CQIM 作为主应用，将此段替换 location / 段
    location /cqim {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Web 前端（https://wed.imim.chat -> 端口 82 WuKongIM）
    location / {
        proxy_pass http://127.0.0.1:82;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}
