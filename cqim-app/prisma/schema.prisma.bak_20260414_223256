generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid()) @map("_id")
  username    String   @unique
  email       String?  @unique
  phone       String?  @unique
  password    String
  nickname    String?
  avatar      String?
  bio         String?
  isBanned    Boolean  @default(false)
  banReason   String?
  role        String   @default("user")
  phoneVerified Boolean @default(false)
  emailVerified Boolean @default(false)
  lastLoginAt DateTime?
  lastLoginIp String?
  fcmToken    String?  // Firebase Cloud Messaging 推送 Token
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  moments     Moment[]
  comments    MomentComment[]
  likes       MomentLike[]
  loginLogs   LoginLog[]
  sessions    UserSession[]
  mediaFiles  MediaFile[]
  hiddenChats ChatHidden[]
}

model UserSession {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  token     String   @unique
  device    String?
  ip        String?
  location  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  /// 覆盖索引：鉴权查询同时需要 token + expiresAt
  @@index([token, expiresAt])
}

/// 短信/邮箱验证码
model VerifyCode {
  id        String   @id @default(cuid()) @map("_id")
  target    String           // 手机号或邮箱
  code      String           // 6位验证码
  type      String           // register | login | bind | reset
  channel   String           // sms | email
  used      Boolean  @default(false)
  attempts  Int      @default(0)  // 验证尝试次数
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([target, type, channel])
  @@index([expiresAt])
  /// 覆盖索引：验证码校验查询
  @@index([target, type, channel, used, expiresAt])
}

model Moment {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  content     String
  visibility  String   @default("public")
  location    String?
  topics      String?
  isPinned    Boolean  @default(false)
  pinnedAt    DateTime?
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       MomentMedia[]
  comments    MomentComment[]
  likes       MomentLike[]
  @@index([userId])
  @@index([createdAt])
  @@index([isPinned])
}

model MomentMedia {
  id        String   @id @default(cuid()) @map("_id")
  momentId  String
  type      String
  url       String
  width     Int?
  height    Int?
  duration  Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  @@index([momentId])
}

model MomentComment {
  id        String   @id @default(cuid()) @map("_id")
  momentId  String
  userId    String
  content   String
  replyToId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  moment    Moment         @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo   MomentComment? @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   MomentComment[] @relation("CommentReplies")
  @@index([momentId])
  @@index([userId])
}

model MomentLike {
  id        String   @id @default(cuid()) @map("_id")
  momentId  String
  userId    String
  createdAt DateTime @default(now())
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([momentId, userId])
  @@index([momentId])
  @@index([userId])
}

model MediaFile {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  type      String
  url       String
  filename  String?
  size      Int?
  width     Int?
  height    Int?
  cosKey    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model AdminAccount {
  id        String   @id @default(cuid()) @map("_id")
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  AdminSession[]
  logs      AdminLog[]
}

model AdminSession {
  id        String   @id @default(cuid()) @map("_id")
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminLog {
  id        String   @id @default(cuid()) @map("_id")
  adminId   String?
  adminName String?
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
  admin     AdminAccount? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  @@index([adminId])
  @@index([createdAt])
}

model LoginLog {
  id         String   @id @default(cuid()) @map("_id")
  userId     String?
  username   String?
  email      String?
  phone      String?
  ip         String?
  userAgent  String?
  country    String?
  city       String?
  success    Boolean  @default(true)
  failReason String?
  loginType  String?  // password | sms | email | phone_auth
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([ip])
  @@index([createdAt])
}

model IpBlacklist {
  id        String   @id @default(cuid()) @map("_id")
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IllegalRequest {
  id         String   @id @default(cuid()) @map("_id")
  ip         String?
  path       String?
  method     String?
  userAgent  String?
  reason     String?
  statusCode Int?
  createdAt  DateTime @default(now())
  @@index([ip])
  @@index([createdAt])
}

model SystemConfig {
  key       String   @id @map("_id")
  value     String
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid()) @map("_id")
  title     String
  content   String
  type      String   @default("info")
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive])
  @@index([createdAt])
}

model SensitiveWord {
  id        String   @id @default(cuid()) @map("_id")
  word      String   @unique
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([isActive])
}

model Report {
  id          String   @id @default(cuid()) @map("_id")
  reporterId  String?
  targetType  String
  targetId    String
  reason      String
  status      String   @default("pending")
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model CustomPage {
  id        String   @id @default(cuid()) @map("_id")
  title     String
  slug      String   @unique
  content   String
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published])
  @@index([sortOrder])
}

// ============ 好友关系系统 ============

/// 好友申请
model FriendRequest {
  id          String   @id @default(cuid()) @map("_id")
  /// 发起方用户 ID
  fromId      String
  /// 接收方用户 ID
  toId        String
  /// 附言
  message     String?  @default("")
  /// 状态：pending | accepted | rejected
  status      String   @default("pending")
  /// 搜索方式：id | phone | email
  searchMethod String  @default("id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
  @@index([status])
}

/// 好友关系（双向，acceptedAt 记录建立时间）
model Friendship {
  id          String   @id @default(cuid()) @map("_id")
  /// userId 字典序较小的一方
  userA       String
  /// userId 字典序较大的一方
  userB       String
  createdAt   DateTime @default(now())
  @@unique([userA, userB])
  @@index([userA])
  @@index([userB])
}

// ============ 私聊会话与消息系统 ============

/// 私聊会话（两人之间的一对一会话）
model Chat {
  id            String   @id @default(cuid()) @map("_id")
  /// 参与者A（userId 字典序较小的一方）
  participantA  String
  /// 参与者B（userId 字典序较大的一方）
  participantB  String
  /// 最后一条消息内容预览
  lastMessage   String?
  /// 最后一条消息时间
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      PrivateMessage[]
  hiddenBy      ChatHidden[]
  /// 唯一约束：两人之间只能有一个会话
  @@unique([participantA, participantB])
  @@index([participantA])
  @@index([participantB])
  @@index([lastMessageAt])
}

/// 用户隐藏的私聊会话（仅对当前用户生效）
model ChatHidden {
  id        String   @id @default(cuid()) @map("_id")
  chatId     String
  userId     String
  hiddenAt   DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, hiddenAt])
  @@index([chatId])
}

/// 私聊消息
model PrivateMessage {
  id            String   @id @default(cuid()) @map("_id")
  chatId        String
  senderId      String
  /// 消息类型：text | image | voice | video | file | system | call | location | location_share
  msgType       String   @default("text")
  /// 文本内容或 JSON 序列化的富媒体数据
  content       String
  /// 引用消息ID
  replyToId     String?
  /// 是否已撤回
  isRevoked     Boolean  @default(false)
  /// 消息状态：sent | delivered | read
  status        String   @default("sent")
  /// 扩展字段（JSON，存储语音URL、图片URL、文件信息等）
  extra         String?
  /// 消息防篡改：HMAC-SHA256 签名（hex 编码，覆盖 content + senderId + chatId + msgType + timestamp）
  hmac          String?
  /// 阅后即焚：消息被阅读后多少秒后销毁（null 表示不自毁）
  burnAfterRead Int?
  /// 阅后即焚：消息被接收方阅读的时间（开始倒计时的起点）
  burnReadAt    DateTime?
  /// 阅后即焚：消息过期时间（burnReadAt + burnAfterRead 秒，便于定时清理）
  burnExpireAt  DateTime?
  createdAt     DateTime @default(now())
  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([chatId, isRevoked])
  /// 阅后即焚：定时清理索引
  @@index([burnExpireAt])
}

// ============ 万人群 IM 消息系统（性能优化版） ============

/// 群组（支持万人规模）
model Group {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  avatar        String?
  ownerId       String
  type          String   @default("normal")  // normal | super（超大群）
  maxMembers    Int      @default(500)
  memberCount   Int      @default(0)
  lastMsgSeq    BigInt   @default(0)          // 群内最新消息序列号
  lastMsgTime   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       GroupMember[]
  messages      GroupMessage[]
  @@index([ownerId])
  @@index([type])
  /// 优化：覆盖索引，getNextSeq / ackGroupMessages 只需 id + lastMsgSeq
  @@index([id, lastMsgSeq])
}

/// 群成员（含已读游标）
model GroupMember {
  id            String   @id @default(cuid()) @map("_id")
  groupId       String
  userId        String
  role          String   @default("member")  // owner | admin | member
  nickname      String?                      // 群昵称
  lastAckSeq    BigInt   @default(0)          // 最后已读消息序列号
  joinTime      DateTime @default(now())
  muteUntil     DateTime?                    // 禁言截止时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  /// 优化：覆盖索引 - pullGroupMessages 需要 joinTime + lastAckSeq
  @@index([groupId, userId, joinTime, lastAckSeq])
  /// 优化：getGroupUnreadCounts 批量查询
  @@index([userId, groupId, lastAckSeq])
}

/// 群消息（读扩散：每条消息只存一份）
model GroupMessage {
  id            String   @id @default(cuid()) @map("_id")
  groupId       String
  seq           BigInt                        // 群内递增序列号
  senderId      String
  senderName    String?
  msgType       String   @default("text")    // text | image | voice | video | file | system | call | location
  content       String                        // 文本内容或 JSON 序列化的富媒体数据
  replyToId     String?                       // 引用消息ID
  isRevoked     Boolean  @default(false)      // 是否已撤回
  extra         String?                       // 扩展字段（JSON）
  createdAt     DateTime @default(now())
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// 唯一约束（自带索引，不再需要额外的 @@index([groupId, seq])）
  @@unique([groupId, seq])
  /// 优化：消息拉取核心索引 - 按 groupId + seq 范围查询 + createdAt 过滤
  @@index([groupId, seq, createdAt])
  /// 优化：发送者维度查询
  @@index([senderId])
  /// 优化：撤回消息查询
  @@index([groupId, isRevoked])
}
