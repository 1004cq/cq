generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  /// TG 风格 Dialog ID（正数 = 用户/机器人）
  dialogId    String?  @unique
  username    String   @unique
  email       String?  @unique
  phone       String?  @unique
  password    String
  nickname    String?
  avatar      String?
  backgroundUrl String?
  bio         String?
  gender      String?
  region      String?
  birthday    String?
  /// 是否为机器人（TG 风格：正数 ID，is_bot=true）
  isBot       Boolean  @default(false)
  isBanned    Boolean  @default(false)
  banReason   String?
  role        String   @default("user")
  phoneVerified Boolean @default(false)
  emailVerified Boolean @default(false)
  lastLoginAt DateTime?
  lastLoginIp String?
  fcmToken    String?  // Firebase Cloud Messaging 推送 Token
  voipToken   String?  // iOS PushKit VoIP 推送 Token
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  moments     Moment[]
  comments    MomentComment[]
  likes       MomentLike[]
  loginLogs   LoginLog[]
  sessions    UserSession[]
  mediaFiles  MediaFile[]
  hiddenChats ChatHidden[]
  @@index([dialogId])
  @@index([username])
  @@index([email])
  @@index([phone])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  device    String?
  ip        String?
  location  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([token])
  @@index([userId])
  /// 覆盖索引：鉴权查询同时需要 token + expiresAt
  @@index([token, expiresAt])
}

/// 短信/邮箱验证码
model VerifyCode {
  id        String   @id @default(cuid())
  target    String           // 手机号或邮箱
  code      String           // 6位验证码
  type      String           // register | login | bind | reset
  channel   String           // sms | email
  used      Boolean  @default(false)
  attempts  Int      @default(0)  // 验证尝试次数
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([target, type, channel])
  @@index([expiresAt])
  /// 覆盖索引：验证码校验查询
  @@index([target, type, channel, used, expiresAt])
}

model Moment {
  id          String   @id @default(cuid())
  userId      String
  content     String
  visibility  String   @default("public")
  location    String?
  topics      String?
  isPinned    Boolean  @default(false)
  pinnedAt    DateTime?
  viewCount   Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       MomentMedia[]
  comments    MomentComment[]
  likes       MomentLike[]
  @@index([userId])
  @@index([createdAt])
  @@index([isPinned])
  @@index([sortOrder])
  /// 复合索引：朋友圈 Feed、个人主页按时间倒序查询
  @@index([userId, createdAt])
  /// 复合索引：公开列表 / 外链页按可见范围 + 时间倒序查询
  @@index([visibility, createdAt])
  /// 复合索引：置顶动态查询（仅查询本人的置顶）
  @@index([userId, isPinned, pinnedAt])
}

model MomentMedia {
  id        String   @id @default(cuid())
  momentId  String
  type      String
  url       String
  width     Int?
  height    Int?
  duration  Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  @@index([momentId])
}

model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  content   String
  replyToId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  moment    Moment         @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo   MomentComment? @relation("CommentReplies", fields: [replyToId], references: [id])
  replies   MomentComment[] @relation("CommentReplies")
  @@index([momentId])
  @@index([userId])
}

model MomentLike {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  createdAt DateTime @default(now())
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([momentId, userId])
  @@index([momentId])
  @@index([userId])
}

model MediaFile {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  url       String
  filename  String?
  size      Int?
  width     Int?
  height    Int?
  cosKey    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model AdminAccount {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  AdminSession[]
  logs      AdminLog[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([token])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String?
  adminName String?
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
  admin     AdminAccount? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  @@index([adminId])
  @@index([createdAt])
}

model LoginLog {
  id         String   @id @default(cuid())
  userId     String?
  username   String?
  email      String?
  phone      String?
  ip         String?
  userAgent  String?
  country    String?
  city       String?
  success    Boolean  @default(true)
  failReason String?
  loginType  String?  // password | sms | email | phone_auth
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([ip])
  @@index([createdAt])
}

model IpBlacklist {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ip])
}

model IllegalRequest {
  id         String   @id @default(cuid())
  ip         String?
  path       String?
  method     String?
  userAgent  String?
  reason     String?
  statusCode Int?
  createdAt  DateTime @default(now())
  @@index([ip])
  @@index([createdAt])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("info")
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive])
  @@index([createdAt])
}

model SensitiveWord {
  id        String   @id @default(cuid())
  word      String   @unique
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([word])
  @@index([isActive])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String?
  targetType  String
  targetId    String
  reason      String
  status      String   @default("pending")
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model CustomPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([slug])
  @@index([published])
}

// ============ 好友关系系统 ============

/// 好友申请
model FriendRequest {
  id          String   @id @default(cuid())
  /// 发起方用户 ID
  fromId      String
  /// 接收方用户 ID
  toId        String
  /// 附言
  message     String?  @default("")
  /// 状态：pending | accepted | rejected
  status      String   @default("pending")
  /// 搜索方式：id | phone | email
  searchMethod String  @default("id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
  @@index([status])
}

/// 好友关系（双向，acceptedAt 记录建立时间）
model Friendship {
  id          String   @id @default(cuid())
  /// userId 字典序较小的一方
  userA       String
  /// userId 字典序较大的一方
  userB       String
  createdAt   DateTime @default(now())
  @@unique([userA, userB])
  @@index([userA])
  @@index([userB])
}

// ============ 私聊会话与消息系统 ============

/// 私聊会话（两人之间的一对一会话）
model Chat {
  id            String   @id @default(cuid())
  /// 参与者A（userId 字典序较小的一方）
  participantA  String
  /// 参与者B（userId 字典序较大的一方）
  participantB  String
  /// 最后一条消息内容预览
  lastMessage   String?
  /// 最后一条消息时间
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      PrivateMessage[]
  hiddenBy      ChatHidden[]
  /// 唯一约束：两人之间只能有一个会话
  @@unique([participantA, participantB])
  @@index([participantA])
  @@index([participantB])
  @@index([lastMessageAt])
}

/// 用户隐藏的私聊会话（仅对当前用户生效）
model ChatHidden {
  id        String   @id @default(cuid())
  chatId     String
  userId     String
  hiddenAt   DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, hiddenAt])
  @@index([chatId])
}

/// 私聊消息
model PrivateMessage {
  id            String   @id @default(cuid())
  chatId        String
  senderId      String
  /// 消息类型：text | image | voice | video | file | system | call | location | location_share
  msgType       String   @default("text")
  /// 文本内容或 JSON 序列化的富媒体数据
  content       String
  /// 引用消息ID
  replyToId     String?
  /// 是否已撤回
  isRevoked     Boolean  @default(false)
  /// 消息状态：sent | delivered | read
  status        String   @default("sent")
  /// 扩展字段（JSON，存储语音URL、图片URL、文件信息等）
  extra         String?
  /// 消息防篡改：HMAC-SHA256 签名（hex 编码，覆盖 content + senderId + chatId + msgType + timestamp）
  hmac          String?
  /// 阅后即焚：消息被阅读后多少秒后销毁（null 表示不自毁）
  burnAfterRead Int?
  /// 阅后即焚：消息被接收方阅读的时间（开始倒计时的起点）
  burnReadAt    DateTime?
  /// 阅后即焚：消息过期时间（burnReadAt + burnAfterRead 秒，便于定时清理）
  burnExpireAt  DateTime?
  createdAt     DateTime @default(now())
  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([chatId, isRevoked])
  /// 阅后即焚：定时清理索引
  @@index([burnExpireAt])
}

// ============ 万人群 IM 消息系统（性能优化版） ============

/// 群组（支持万人规模）
model Group {
  id            String   @id @default(cuid())
  /// TG 风格 Dialog ID（负数 = 普通群，-100前缀 = 超级群/频道）
  dialogId      String?  @unique
  name          String
  /// 公开用户名（用于外链 /im/username，类似 TG @username）
  username      String?  @unique
  avatar        String?
  ownerId       String
  type          String   @default("normal")  // normal | super | channel（TG 风格）
  /// 是否公开（公开群可通过 username 搜索和加入）
  isPublic      Boolean  @default(false)
  maxMembers    Int      @default(500)
  memberCount   Int      @default(0)
  lastMsgSeq    BigInt   @default(0)          // 群内最新消息序列号
  lastMsgTime   DateTime?
  /// 群公告
  announcement  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       GroupMember[]
  messages      GroupMessage[]
  invites       GroupInvite[]
  inviteLinks   InviteLink[]
  @@index([dialogId])
  @@index([username])
  @@index([ownerId])
  @@index([type])
  @@index([isPublic])
  /// 优化：覆盖索引，getNextSeq / ackGroupMessages 只需 id + lastMsgSeq
  @@index([id, lastMsgSeq])
}

/// 群成员（含已读游标）
model GroupMember {
  id            String   @id @default(cuid())
  groupId       String
  userId        String
  role          String   @default("member")  // owner | admin | member
  nickname      String?                      // 群昵称
  lastAckSeq    BigInt   @default(0)          // 最后已读消息序列号
  joinTime      DateTime @default(now())
  muteUntil     DateTime?                    // 禁言截止时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  /// 优化：覆盖索引 - pullGroupMessages 需要 joinTime + lastAckSeq
  @@index([groupId, userId, joinTime, lastAckSeq])
  /// 优化：getGroupUnreadCounts 批量查询
  @@index([userId, groupId, lastAckSeq])
}

/// 群消息（读扩散：每条消息只存一份）
model GroupMessage {
  id            String   @id @default(cuid())
  groupId       String
  seq           BigInt                        // 群内递增序列号
  senderId      String
  senderName    String?
  msgType       String   @default("text")    // text | image | voice | video | file | system | call | location | mls_encrypted
  content       String                        // 文本内容或 JSON 序列化的富媒体数据
  replyToId     String?                       // 引用消息ID
  isRevoked     Boolean  @default(false)      // 是否已撤回
  extra         String?                       // 扩展字段（JSON）
  /// MLS E2EE 加密标记（true = 内容已加密，服务器无法解密）
  mlsEncrypted  Boolean  @default(false)
  /// MLS epoch（加密时的密钥版本）
  mlsEpoch      Int?     @default(0)
  /// 阅后即焚：消息被阅读后多少秒后销毁（null 表示不自毁）
  burnAfterRead Int?
  /// 阅后即焚：消息过期时间（发送时间 + burnAfterRead 秒，便于定时清理）
  burnExpireAt  DateTime?
  createdAt     DateTime @default(now())
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// 唯一约束（自带索引，不再需要额外的 @@index([groupId, seq])）
  @@unique([groupId, seq])
  /// 优化：消息拉取核心索引 - 按 groupId + seq 范围查询 + createdAt 过滤
  @@index([groupId, seq, createdAt])
  /// 优化：发送者维度查询
  @@index([senderId])
  /// 优化：撤回消息查询
  @@index([groupId, isRevoked])
  /// 优化：阅后即焚定时清理索引
  @@index([burnExpireAt])
  /// 优化：MLS 加密消息查询
  @@index([groupId, mlsEncrypted])
}

// ============ 群邀请系统 ============

/// 群聊邀请请求（邀请好友加入群聊，需要对方同意/拒绝）
model GroupInvite {
  id          String   @id @default(cuid())
  /// 群组 ID
  groupId     String
  /// 邀请人用户 ID
  inviterId   String
  /// 被邀请人用户 ID
  inviteeId   String
  /// 附言
  message     String?  @default("")
  /// 状态：pending | accepted | rejected
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([groupId, inviteeId, status])
  @@index([inviterId])
  @@index([inviteeId])
  @@index([groupId])
  @@index([status])
}

// ============ TG 风格邀请链接系统 ============

/// 群组邀请链接（支持公开外链 + 私人邀请链接）
model InviteLink {
  id          String    @id @default(cuid())
  /// 邀请链接 hash（URL 安全 base64，22 位）
  hash        String    @unique
  /// 关联群组 ID
  groupId     String
  /// 创建者用户 ID
  creatorId   String
  /// 链接名称/备注
  name        String?
  /// 过期时间（null = 永不过期）
  expireAt    DateTime?
  /// 最大使用次数（0 = 无限制）
  maxUses     Int       @default(0)
  /// 已使用次数
  usedCount   Int       @default(0)
  /// 是否已撤销
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@index([hash])
  @@index([groupId])
  @@index([creatorId])
  @@index([expireAt])
}
